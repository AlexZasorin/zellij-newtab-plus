Output demo.gif

Set FontSize 14
Set Width 1200
Set Height 600
Set Theme "Builtin Solarized Dark"
Set Padding 20
Set WindowBar Colorful

Sleep 1s

# Type a command in the terminal.
Type "zellij"

# Pause for dramatic effect...
Sleep 2s

# Run the command by pressing enter.
Enter

Sleep 2s

# Trigger the plugin
Ctrl+t
Type "n"

Sleep 2s

# Enter new tab name
Type "my-project-tab"

Sleep 2s

Enter

Sleep 5s


